{
  "name": "dsh-minimax-usage",
  "version": "0.1.7",
  "description": "Show MiniMax Token Plan subscription usage in the DSH Web UI",
  "type": "module",
  "files": [
    "dist/",
    "assets/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-client.mjs",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.2-rc.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pan17/dsh-minimax-usage.git"
  },
  "keywords": [
    "minimax",
    "token-plan",
    "dsh",
    "deepseek-harness",
    "cordis"
  ]
}
